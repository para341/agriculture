<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xueye.xueyeWarn.mapper.UserMapper">
    <!-- 根据用户名查询用户 -->
    <select id="getUserByUsername" parameterType="String" resultType="com.xueye.xueyeWarn.bean.User">
        SELECT * FROM user WHERE username = #{username}
    </select>
</mapper>